# ================================
# PMM Client — PostgreSQL VM
# ================================
# แก้ไขค่าด้านล่างก่อน deploy

# --- PMM Server ---
PMM_AGENT_SERVER_ADDRESS=<PMM_SERVER_IP>:443
PMM_AGENT_SERVER_USERNAME=admin
PMM_AGENT_SERVER_PASSWORD=<PMM_ADMIN_PASSWORD>

# --- PostgreSQL DB Credentials (สำหรับ pmm-admin add) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=pmm
DB_PASS=<POSTGRES_PMM_PASSWORD>

# --- Service Identity (ต้อง unique ทั้งระบบ) ---
# รูปแบบ: <hostname>-postgresql  เช่น db-app1-postgresql
SERVICE_NAME=<HOSTNAME>-postgresql
CLUSTER_NAME=pg-cluster-01