# ================================
# PMM Client — MySQL VM
# ================================
# แก้ไขค่าด้านล่างก่อน deploy

# --- PMM Server ---
PMM_AGENT_SERVER_ADDRESS=<PMM_SERVER_IP>:443
PMM_AGENT_SERVER_USERNAME=admin
PMM_AGENT_SERVER_PASSWORD=<PMM_ADMIN_PASSWORD>

# --- MySQL DB Credentials (สำหรับ pmm-admin add) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=pmm
DB_PASS=<MYSQL_PMM_PASSWORD>

# --- Service Identity (ต้อง unique ทั้งระบบ) ---
# รูปแบบ: <hostname>-mysql  เช่น db-app1-mysql
SERVICE_NAME=<HOSTNAME>-mysql
CLUSTER_NAME=mysql-cluster-01