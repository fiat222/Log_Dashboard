# nginx.conf — Dashboard container Nginx configuration
# Purpose: serve dashboard static files AND reverse-proxy /clickhouse → ClickHouse:8123
# This avoids CORS issues when the browser JS queries ClickHouse directly.
# Mount this file into the log-dashboard container if needed, or bake it via Dockerfile.

server {
    listen 80;
    server_name _;

    # ── Static dashboard files ─────────────────────────────────────────────
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store" always;
    }

    # ── Reverse proxy: /clickhouse → ClickHouse HTTP API ──────────────────
    # The browser JS fetches /clickhouse/?query=... which proxies here.
    # Credentials are NOT embedded in JS — they're set via proxy_set_header.
    location /clickhouse/ {
        proxy_pass http://clickhouse:8123/;

        # Inject ClickHouse credentials server-side — never exposed to browser
        proxy_set_header X-ClickHouse-User     "loguser";
        proxy_set_header X-ClickHouse-Key      "${CLICKHOUSE_PASSWORD}";
        proxy_set_header X-ClickHouse-Database "logs";

        proxy_read_timeout       30s;
        proxy_connect_timeout    5s;
        proxy_send_timeout       30s;

        # Allow only SELECT queries through — block mutations from browser
        # (Mutations come from server-side clear-DB action via app.js only)
        # Note: Full mutation blocking would require a Lua filter or WAF.
        # For now we rely on the loguser account having restricted permissions.

        add_header Access-Control-Allow-Origin  "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;
    }

    # ── Health check endpoint ──────────────────────────────────────────────
    location /health {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    # ── Security headers ───────────────────────────────────────────────────
    add_header X-Frame-Options      "SAMEORIGIN"       always;
    add_header X-Content-Type-Options "nosniff"        always;
    add_header Referrer-Policy      "strict-origin"    always;

    # Disable access logs for static assets to reduce container log noise
    location ~* \.(css|js|woff2?|png|ico|svg)$ {
        access_log off;
        expires 1h;
    }
}
