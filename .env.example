# .env — Environment variables for docker-compose.yml
# Copy this file to .env and fill in strong passwords before first deploy.
# Do NOT commit .env to version control.

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=change_me_strong_password_here

# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_admin_password
