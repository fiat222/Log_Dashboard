# .env — Environment variables for docker-compose.yml
# Copy this file to .env and fill in strong passwords before first deploy.
# Do NOT commit .env to version control.

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=change_me_strong_password_here

# ── PostgreSQL (user management database) ─────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres_password_here

# ── JWT Secret (generate with: openssl rand -hex 32) ──────────────────────────
JWT_SECRET_KEY=please-change-this-to-a-very-long-random-secret-key

# ── Super Admin credentials (manual, not via SSO) ─────────────────────────────
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change_me_superadmin_password
# Optional: use bcrypt hash instead of plain-text password (more secure)
# Generate with: python3 -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"
# SUPER_ADMIN_PASSWORD_HASH=$2b$12$...

# ── PSU SSO / Authentik (fill in when credentials available from PSU IT) ───────
AUTHENTIK_BASE_URL=https://sso.psu.ac.th
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://monitor-eila.psu.ac.th/log/auth/callback
