# Central Stack Environment Example
#
# This file describes the future central install surface.
# The current working root stack still uses ../.env.example.

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=central-observability
APP_DOMAIN=observability.local
APP_BASE_PATH=/logstore
APP_PORT=8801
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8801,http://127.0.0.1:8801

# ── Images ──────────────────────────────────────────────────────────────────
REGISTRY_IMAGE_PATH=local
TAG=dev

# ── Admin ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=CHANGE_ME_superadmin
SUPER_ADMIN_PASSWORD_HASH=

# ── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=observability
CLICKHOUSE_USER=loguser
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# ── PostgreSQL metadata store ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=observability_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=CHANGE_ME_postgres
DATABASE_URL=postgresql+asyncpg://platform:CHANGE_ME_postgres@postgres:5432/observability_platform

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis
SESSION_TTL_DAYS=30

# ── Telemetry ingress ───────────────────────────────────────────────────────
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4317
OTEL_METRICS_PORT=8888

# ── Authentik mock / future SSO ─────────────────────────────────────────────
AUTH_MODE=local
AUTHENTIK_BASE_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8801/logstore/callback/login
AUTHENTIK_SCOPES=openid profile email

