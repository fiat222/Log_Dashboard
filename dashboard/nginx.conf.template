# nginx.conf.template — Log Dashboard (Fixed Static Assets)

# ── HTTP → HTTPS redirect ──────────────────────────────────────────────────────
server {
    listen 80;
    server_name monitor-eila.psu.ac.th;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name monitor-eila.psu.ac.th;

    # ── Security headers ───────────────────────────────────────────────────────
    add_header X-Frame-Options       "SAMEORIGIN"  always;
    add_header X-Content-Type-Options "nosniff"    always;
    add_header Referrer-Policy       "strict-origin" always;

    # ── Path prefix: /logstore ────────────────────────────────────────────────────────
    
    # SSO Callback interceptor for the new Redirect URI
    location = /logstore/callback/login {
        proxy_pass         http://backend:8000/auth/callback;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Login page & fallback SSO interceptor
    location = /logstore/login {
        if ($arg_code) {
            rewrite ^ /logstore/auth/callback last;
        }
        alias /usr/share/nginx/html/login/;
        try_files index.html =404;
    }
    location /logstore/login/ {
        alias /usr/share/nginx/html/login/;
        try_files $uri $uri/ /login/index.html;
    }

    # Backend API Proxy
    location /logstore/api/ {
        proxy_pass         http://backend:8000/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering    off;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
    }

    location /logstore/auth/ {
        proxy_pass         http://backend:8000/auth/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }

    # PSU SSO Redirect URI Support
    location = /login/generic_oauth {
        proxy_pass         http://backend:8000/auth/callback;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── ClickHouse HTTP proxy — internal Docker DNS, no public port needed ──────
    location /clickhouse/ {
        proxy_pass         http://clickhouse:8123/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;

        # Production CORS — only own domain
        add_header Access-Control-Allow-Origin  "https://monitor-eila.psu.ac.th" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # Static dashboard files & Assets
    location /logstore/ {
        alias   /usr/share/nginx/html/;
        index   index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store" always;

        # ชุดนี้จะจัดการไฟล์ .css, .js ให้ดึงจาก alias ด้านบนได้ถูกต้อง
        location ~* \.(css|js|woff2?|png|ico|svg)$ {
            access_log off;
            expires 1h;
            add_header Cache-Control "public, no-transform";
        }
    }

    location = /logstore {
        return 301 /logstore/;
    }

    # ── Health check ───────────────────────────────────────────────────────────
    location /health {
        return 200 "ok";
        add_header Content-Type text/plain;
    }
}
