# Edge Agent Environment Example

# Stable host identity. Must not change across restarts.
EDGE_HOST_ID=home-server
EDGE_SITE=home-lab
EDGE_ENV=dev

# Central endpoints.
# Use LAN IP, DNS name, or domain reachable from this edge host.
CENTRAL_OTEL_ENDPOINT=http://192.168.1.10:4318
CENTRAL_API_ENDPOINT=http://192.168.1.10:8000

# Optional hint for docs/UI. Prometheus usually scrapes exporters from central.
CENTRAL_PROMETHEUS_SCRAPE_HINT=http://192.168.1.10:9090

# Future auth token for registering/sending metadata to central.
EDGE_AUTH_TOKEN=CHANGE_ME_edge_token

# Exporter ports exposed on the edge host.
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080

# Vector runtime.
VECTOR_LOG_LEVEL=info

