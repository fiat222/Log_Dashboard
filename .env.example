# .env — Environment variables for docker-compose.yml
# Copy this file to .env and fill in strong passwords before first deploy.
# Do NOT commit .env to version control.
#
# REQUIRED: generate strong secrets before deploy:
#   JWT_SECRET_KEY:    openssl rand -hex 32
#   REDIS_PASSWORD:    openssl rand -hex 24
#   CLICKHOUSE_PASSWORD: use a password manager

# ── Registry ───────────────────────────────────────────────────────────────────
REGISTRY_IMAGE_PATH=registry.in.psu.ac.th:443/6610110116/log_dashboard

# ── Host ───────────────────────────────────────────────────────────────────────
# Set to server hostname (used by otel-agent for resource detection)
HOSTNAME=monitor-eila

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=observability
CLICKHOUSE_USER=loguser
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1


# ── Redis (cache + rate-limit only — no longer in log pipeline) ────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Required: Redis password — generate with: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_redis

# ── JWT Secret (generate with: openssl rand -hex 32) ──────────────────────────
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_min32chars

# ── Cookie security ───────────────────────────────────────────────────────────
# Set to false only for local HTTP development; must be true in production (HTTPS)
COOKIE_SECURE=true

# ── Session lifetime ──────────────────────────────────────────────────────────
# Days until session expires after last activity (sliding window in Redis)
SESSION_TTL_DAYS=30

# ── Super Admin credentials (manual, not via SSO) ─────────────────────────────
SUPER_ADMIN_USERNAME=superadmin
# Use bcrypt hash in production (plain-text fallback is dev-only):
# Generate: python3 -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"
SUPER_ADMIN_PASSWORD_HASH=
# Plain-text only if SUPER_ADMIN_PASSWORD_HASH is unset — change this:
SUPER_ADMIN_PASSWORD=CHANGE_ME_superadmin

# ── PSU SSO / Authentik ────────────────────────────────────────────────────────
# Application: eila-monitor
AUTHENTIK_BASE_URL=https://eila.psu.ac.th/authen
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost/logstore/callback/login
AUTHENTIK_SCOPES=openid profile email

# ── Backend ────────────────────────────────────────────────────────────────────
# External PostgreSQL — eilapgsql.in.psu.ac.th:5432
# Fill in <DB_NAME>, <USER>, <PASS> before deploy:
DATABASE_URL=postgresql+asyncpg://<USER>:<PASS>@eilapgsql.in.psu.ac.th:5432/<DB_NAME>
APP_BASE_PATH=/logstore
WEBHOOK_URL=

# ── CORS (comma-separated origins; leave empty for default) ───────────────────
# Default includes https://monitor-eila.psu.ac.th + localhost variants.
# Override for custom domains: CORS_ORIGINS=https://yourdomain.com,http://localhost
CORS_ORIGINS=
