# nginx.conf.template — Log Dashboard (Fixed Static Assets)

server {
    listen 80;
    server_name _;

    # ── Security headers ───────────────────────────────────────────────────────
    add_header X-Frame-Options       "SAMEORIGIN"  always;
    add_header X-Content-Type-Options "nosniff"    always;
    add_header Referrer-Policy       "strict-origin" always;

    # ── Path prefix: /log ──────────────────────────────────────────────────────
    
    # Login page & SSO Callback interceptor
    location = /log/login {
        if ($arg_code) {
            rewrite ^ /log/auth/callback last;
        }
        alias /usr/share/nginx/html/login/;
        try_files index.html =404;
    }
    location /log/login/ {
        alias /usr/share/nginx/html/login/;
        try_files $uri $uri/ /login/index.html;
    }

    # Backend API Proxy
    location /log/api/ {
        proxy_pass         http://backend:8000/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering    off;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
    }

    location /log/auth/ {
        proxy_pass         http://backend:8000/auth/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }

    # PSU SSO Redirect URI Support
    location = /login/generic_oauth {
        proxy_pass         http://backend:8000/auth/callback;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Static dashboard files & Assets
    location /log/ {
        alias   /usr/share/nginx/html/;
        index   index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store" always;

        # ชุดนี้จะจัดการไฟล์ .css, .js ให้ดึงจาก alias ด้านบนได้ถูกต้อง
        location ~* \.(css|js|woff2?|png|ico|svg)$ {
            access_log off;
            expires 1h;
            add_header Cache-Control "public, no-transform";
        }
    }

    location = /log {
        return 301 /log/;
    }

    # ── Health check ───────────────────────────────────────────────────────────
    location /health {
        return 200 "ok";
        add_header Content-Type text/plain;
    }
}
