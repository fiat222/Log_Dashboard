# .env — Environment variables for docker-compose.yml
# Copy this file to .env and fill in strong passwords before first deploy.
# Do NOT commit .env to version control.
# GitLab Registry Path
REGISTRY_IMAGE_PATH=registry.in.psu.ac.th:443/6610110116/log_dashboard

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=clickhouse_admin

# ── PostgreSQL (user management database) ─────────────────────────────────────
POSTGRES_PASSWORD=postgres_admin

# ── JWT Secret (generate with: openssl rand -hex 32) ──────────────────────────
JWT_SECRET_KEY=79GBAGV8D6FC154DSF686A79F37058C1

# ── Super Admin credentials (manual, not via SSO) ─────────────────────────────
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=admin1234
# Optional: use bcrypt hash instead of plain-text password (more secure)
# Generate with: python3 -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"
# SUPER_ADMIN_PASSWORD_HASH=$2b$12$...

# ── PSU SSO / Authentik ─────────────────────────────────────────────────────
# Application: eila-monitor
# Config: https://eila.psu.ac.th/authen/application/o/eila-monitor/.well-known/openid-configuration
AUTHENTIK_BASE_URL=https://eila.psu.ac.th/authen
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost/logstore/callback/login
AUTHENTIK_SCOPES=openid profile email

# ── Log Pipeline / Filebeat ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_KEY=filebeat

# Containers to exclude from log collection
EXCLUDE_CONTAINER_1=filebeat
EXCLUDE_CONTAINER_2=redis
EXCLUDE_CONTAINER_3=clickhouse

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=logdash
POSTGRES_USER=loguser

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=logs
CLICKHOUSE_USER=loguser
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# ── Log Ingester ───────────────────────────────────────────────────────────────
BATCH_SIZE=200
FLUSH_INTERVAL=3

# ── Backend ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://loguser:postgres_admin@postgres:5432/logdash
APP_BASE_PATH=/logstore
WEBHOOK_URL=
