# .env - environment variables for docker-compose.yml
# Copy this file to .env and fill in strong passwords before first deploy.
# Do not commit .env to version control.
#
# Required secret generation examples:
#   JWT_SECRET_KEY:      openssl rand -hex 32
#   REDIS_PASSWORD:      openssl rand -hex 24
#   CLICKHOUSE_PASSWORD: use a password manager

# Images
TAG=local

# Host identity used by telemetry resource detection
HOSTNAME=local-observability

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=observability
CLICKHOUSE_USER=loguser
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# Redis cache and rate limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis

# JWT session signing secret. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_min32chars

# Cookie security. Use false only for local HTTP development; production must use HTTPS and true.
COOKIE_SECURE=true

# Sliding session lifetime in days
SESSION_TTL_DAYS=30

# Emergency local superadmin login, not SSO
SUPER_ADMIN_USERNAME=superadmin
# Use bcrypt hash in production. Generate with:
# python3 -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_PASSWORD=CHANGE_ME_superadmin

# Optional SSO / Authentik. Leave empty for local superadmin-only development.
AUTHENTIK_BASE_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost/logstore/callback/login
AUTHENTIK_SCOPES=openid profile email

# PostgreSQL metadata DB
POSTGRES_USER=loguser
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=logdash

# Backend
APP_BASE_PATH=/logstore
WEBHOOK_URL=

# CORS. Comma-separated origins; leave empty for defaults including localhost variants.
CORS_ORIGINS=

# Workload database monitoring profiles. Prefer dsn_env so secrets stay out of JSON.
# Example:
# WORKLOAD_DATABASE_PROFILES=[{"id":"orders-db","name":"Orders PostgreSQL","type":"postgres","dsn_env":"ORDERS_DATABASE_URL"}]
# ORDERS_DATABASE_URL=postgresql://readonly:change_me@orders-db:5432/orders
WORKLOAD_DATABASE_PROFILES=
